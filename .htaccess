
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(includes|uploads|database)(/|$) - [F,L]
</IfModule>

<FilesMatch "\.(sql|md|log|ini|json)$">
  Require all denied
</FilesMatch>

<IfModule mod_php.c>
  php_value upload_max_filesize 4M
  php_value post_max_size 8M
</IfModule>
